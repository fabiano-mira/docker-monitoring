{
  "uid": "netdata-host-metrics",
  "title": "Netdata Host Metrics (macOS)",
  "tags": [
    "netdata",
    "host"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (%) by dimension",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bfx714adccgsga"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "netdata_system_cpu_percentage_average{job=\"netdata\"}",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM Usage (MiB) by dimension",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bfx714adccgsga"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "netdata_system_ram_MiB_average{job=\"netdata\"}",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "System Load Average",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bfx714adccgsga"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "netdata_system_load_load_average{job=\"netdata\"}",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Netdata Target Health (up=1)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bfx714adccgsga"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"netdata\"}",
          "legendFormat": "netdata scrape up",
          "refId": "A"
        }
      ]
    }
  ]
}