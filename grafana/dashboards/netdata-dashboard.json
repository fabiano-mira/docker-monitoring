{
  "uid": "netdata-host-metrics",
  "title": "Netdata Host Metrics (macOS)",
  "tags": ["netdata", "host"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "CPU Usage by State", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 40, "gradientMode": "opacity", "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [{ "expr": "netdata_system_cpu_percentage_average{job=\"netdata\"}", "legendFormat": "{{dimension}}", "refId": "A" }]
    },
    {
      "id": 2, "title": "RAM by Dimension", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 40, "gradientMode": "opacity", "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [{ "expr": "netdata_system_ram_MiB_average{job=\"netdata\"}", "legendFormat": "{{dimension}}", "refId": "A" }]
    },
    {
      "id": 3, "title": "System Load Average", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 25, "gradientMode": "hue", "showPoints": "never" } }, "overrides": [] },
      "targets": [{ "expr": "netdata_system_load_load_average{job=\"netdata\"}", "legendFormat": "{{dimension}}", "refId": "A" }]
    },
    {
      "id": 4, "title": "Netdata Scrape Health", "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [{ "expr": "up{job=\"netdata\"}", "legendFormat": "netdata scrape", "refId": "A" }]
    }
  ]
}
