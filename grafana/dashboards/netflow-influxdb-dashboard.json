          "query": "from(bucket: \"netflow\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"netflow\" and r._field == \"bytes\") |> aggregateWindow(every: 30s, fn: sum, createEmpty: false) |> map(fn: (r) => ({r with _value: float(v: r._value) / 30.0})) |> group(columns: [\"dst_addr\"])",
