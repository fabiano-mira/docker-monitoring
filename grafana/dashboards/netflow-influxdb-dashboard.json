          }
        },
        "overrides": []
      },
      "targets": [
        {
          "query": "from(bucket: \"netflow\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"netflow\" and r._field == \"bytes\") |> aggregateWindow(every: 30s, fn: count, createEmpty: false) |> group(columns: [\"proto\"])",
