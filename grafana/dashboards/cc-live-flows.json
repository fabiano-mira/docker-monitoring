{
  "uid": "cc-live-flows",
  "title": "Control Center · Live Flows",
  "tags": ["control-center", "ntopng", "infinity", "live"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 100, "type": "row", "title": "Pulse", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 1, "title": "Active Hosts", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-ntopng" },
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [{ "query": "SELECT mean(\"num_hosts\") FROM \"iface:hosts\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series", "refId": "A" }]
    },
    {
      "id": 2, "title": "Active Flows", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-ntopng" },
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [{ "query": "SELECT mean(\"num_flows\") FROM \"iface:flows\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series", "refId": "A" }]
    },
    {
      "id": 3, "title": "Collector Ingest", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "sum(netdata_prometheus_goflow2_netflow_goflow2_flow_traffic_bytes_total_bytes_persec_average{job=\"netdata\"})", "legendFormat": "bytes/s", "refId": "A" }]
    },
    {
      "id": 4, "title": "ZMQ Flows Received", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "influxdb-ntopng" },
      "options": { "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] },
      "targets": [{ "query": "SELECT non_negative_derivative(mean(\"flows\"), 1s) FROM \"iface:zmq_recv_flows\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "resultFormat": "time_series", "refId": "A" }]
    },

    { "id": 101, "type": "row", "title": "Live Flow Topology", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "id": 5, "title": "Who Talks to Whom (live, edge = active flow)", "type": "nodeGraph",
      "gridPos": { "h": 17, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-ntopng" },
      "options": { "nodes": { "mainStatUnit": "bps" }, "edges": { "mainStatUnit": "" } },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-ntopng" },
          "type": "json",
          "source": "url",
          "format": "node-graph-nodes",
          "parser": "backend",
          "url": "http://ntopng:3000/lua/rest/v2/get/host/active.lua?ifid=0&perPage=500",
          "url_options": { "method": "GET" },
          "root_selector": "rsp.data",
          "columns": [
            { "selector": "ip", "text": "id", "type": "string" },
            { "selector": "name", "text": "title", "type": "string" },
            { "selector": "thpt.bps", "text": "mainstat", "type": "number" },
            { "selector": "num_flows.total", "text": "secondarystat", "type": "number" }
          ],
          "refId": "nodes"
        },
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-ntopng" },
          "type": "json",
          "source": "url",
          "format": "node-graph-edges",
          "parser": "backend",
          "url": "http://ntopng:3000/lua/rest/v2/get/flow/active.lua?ifid=0&perPage=500",
          "url_options": { "method": "GET" },
          "root_selector": "rsp.data",
          "columns": [
            { "selector": "key", "text": "id", "type": "string" },
            { "selector": "client.ip", "text": "source", "type": "string" },
            { "selector": "server.ip", "text": "target", "type": "string" },
            { "selector": "protocol.l7", "text": "mainstat", "type": "string" },
            { "selector": "bytes", "text": "secondarystat", "type": "number" }
          ],
          "refId": "edges"
        }
      ]
    },

    { "id": 102, "type": "row", "title": "Live Throughput", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": [] },
    {
      "id": 6, "title": "Top Hosts by Live Throughput", "type": "bargauge",
      "gridPos": { "h": 10, "w": 10, "x": 0, "y": 24 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-ntopng" },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": true, "limit": 15 }, "showUnfilled": true, "valueMode": "color", "sizing": "auto" },
      "fieldConfig": { "defaults": { "unit": "bps", "color": { "mode": "continuous-GrYlRd" }, "min": 0 }, "overrides": [] },
      "transformations": [
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Throughput", "desc": true }] } },
        { "id": "limit", "options": { "limitField": 15 } },
        { "id": "rowsToFields", "options": { "mappings": [ { "fieldName": "Host", "handlerKey": "field.name" }, { "fieldName": "Throughput", "handlerKey": "field.value" } ] } }
      ],
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-ntopng" },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://ntopng:3000/lua/rest/v2/get/host/active.lua?ifid=0&perPage=500&sortColumn=thpt&sortOrder=desc",
          "url_options": { "method": "GET" },
          "root_selector": "rsp.data",
          "columns": [
            { "selector": "name", "text": "Host", "type": "string" },
            { "selector": "thpt.bps", "text": "Throughput", "type": "number" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 7, "title": "Collector Ingest Rate (live gradient)", "type": "timeseries",
      "gridPos": { "h": 10, "w": 14, "x": 10, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "bfx714adccgsga" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 3, "fillOpacity": 50, "gradientMode": "scheme", "showPoints": "never" }, "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "targets": [
        { "expr": "sum(netdata_prometheus_goflow2_netflow_goflow2_flow_traffic_bytes_total_bytes_persec_average{job=\"netdata\"})", "legendFormat": "flow bytes/s", "refId": "A" }
      ]
    },

    { "id": 103, "type": "row", "title": "Live Flow Stream", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "panels": [] },
    {
      "id": 8, "title": "Flow Records (live)", "type": "logs",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "loki", "uid": "ffx74s2v4uq68a" },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": false, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        { "expr": "{job=\"goflow2\"} | json | line_format \"{{.src_addr}}:{{.src_port}} → {{.dst_addr}}:{{.dst_port}} ({{.proto}}) {{.bytes}}B if{{.in_if}}→if{{.out_if}}\"", "refId": "A" }
      ]
    }
  ]
}
