<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.netsampler.goflow2</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/fm/bin/goflow2</string>
    <string>-listen=netflow://:2055</string>
    <string>-transport=file</string>
    <string>-transport.file=/Users/fm/Library/Logs/goflow2/flows.log</string>
    <string>-format=json</string>
    <string>-addr=:8080</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/fm/Library/Logs/goflow2/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/fm/Library/Logs/goflow2/stderr.log</string>
</dict>
</plist>
