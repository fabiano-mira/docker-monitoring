# ntopng to read from. Use the LAN address when the gateway runs elsewhere, or
# http://ntopng:3000 when it shares a Docker network with the ntopng container.
NTOPNG_URL=http://10.9.1.241:3001

# Only needed if ntopng runs without --disable-login 1.
NTOPNG_USER=
NTOPNG_PASSWORD=

# Interface id to read. 0 is the first one; GET /v1/interfaces lists them.
NTOPNG_IFID=0
NTOPNG_TIMEOUT_SECONDS=10

# Comma-separated keys accepted in the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this empty disables authentication entirely — local testing only.
GATEWAY_API_KEYS=

# Response-size caps.
MAX_PAGE_SIZE=500
DEFAULT_LIMIT=10

# Only used by the "tunnel" compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
